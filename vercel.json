{
  "version": 2,
  "name": "st-venus-school-management",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/auth/:match*", "destination": "/api/auth" }
  ],
  "routes": [
    {
      "src": "/api/auth/(.*)",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/auth",
      "dest": "/api/auth.js"
    },
    {
      "src": "/api/students",
      "dest": "/api/students.js"
    },
    {
      "src": "/api/fees",
      "dest": "/api/fees.js"
    },
    {
      "src": "/api/academic",
      "dest": "/api/academic.js"
    },
    {
      "src": "/api/attendance",
      "dest": "/api/attendance.js"
    },
    {
      "src": "/api/state",
      "dest": "/api/state.js"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
